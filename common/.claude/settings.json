{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(CLAUDE.md)",
      "Edit(AGENTS.md)",
      "Edit(.github/**)",
      "Edit(scripts/**)",
      "Edit(docs/decisions/**)",
      "Edit(**/package.json)",
      "Edit(pnpm-lock.yaml)",
      "Edit(**/tsconfig*.json)",
      "Edit(eslint.config.*)",
      "Edit(eslint-rules/**)",
      "Edit(vitest.config.*)",
      "Edit(**/*.gradle.kts)",
      "Edit(gradle/**)",
      "Edit(config/**)",
      "Edit(**/go.mod)",
      "Edit(**/go.sum)",
      "Edit(.golangci.yml)",
      "Edit(**/pyproject.toml)",
      "Edit(uv.lock)",
      "Edit(mise.toml)",
      "Edit(.squawk.toml)",
      "Edit(**/Dockerfile)",
      "Edit(vite.config.*)",
      "Edit(knip.json)",
      "Edit(stryker.config.*)",
      "Edit(.prettierrc*)",
      "Edit(.prettierignore)",
      "Edit(pnpm-workspace.yaml)",
      "Edit(.npmrc)",
      "Edit(.python-version)",
      "Edit(**/versions.tf)",
      "Edit(.tflint.hcl)",
      "Edit(.checkov.yaml)",
      "Edit(.terraform.lock.hcl)",
      "Edit(**/Cargo.toml)",
      "Edit(Cargo.lock)",
      "Edit(**/clippy.toml)",
      "Edit(deny.toml)",
      "Edit(rust-toolchain.toml)",
      "Edit(rustfmt.toml)",
      "Edit(**/*.csproj)",
      "Edit(*.slnx)",
      "Edit(Directory.*.props)",
      "Edit(global.json)",
      "Edit(.editorconfig)",
      "Edit(**/packages.lock.json)",
      "Edit(.config/dotnet-tools.json)",
      "Edit(stryker-config.json)"
    ]
  },
  "sandbox": {
    "filesystem": {
      "denyWrite": [
        "./CLAUDE.md",
        "./AGENTS.md",
        "./.github",
        "./scripts",
        "./docs/decisions",
        "./package.json",
        "./pnpm-lock.yaml",
        "./tsconfig.json",
        "./eslint.config.ts",
        "./eslint-rules",
        "./vitest.config.ts",
        "./build.gradle.kts",
        "./settings.gradle.kts",
        "./gradle",
        "./config",
        "./go.mod",
        "./go.sum",
        "./.golangci.yml",
        "./pyproject.toml",
        "./uv.lock",
        "./mise.toml",
        "./.squawk.toml",
        "./tools/guard",
        "./vite.config.ts",
        "./knip.json",
        "./stryker.config.json",
        "./.prettierrc.json",
        "./.prettierignore",
        "./pnpm-workspace.yaml",
        "./.npmrc",
        "./.python-version",
        "./versions.tf",
        "./.tflint.hcl",
        "./.checkov.yaml",
        "./.terraform.lock.hcl",
        "./Cargo.toml",
        "./Cargo.lock",
        "./deny.toml",
        "./rust-toolchain.toml",
        "./rustfmt.toml",
        "./crates/domain/clippy.toml",
        "./Directory.Build.props",
        "./Directory.Packages.props",
        "./global.json",
        "./.editorconfig",
        "./.config",
        "./stryker-config.json",
        "./App.slnx"
      ]
    }
  }
}
