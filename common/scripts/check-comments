#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
command -v uv >/dev/null || { echo "check-comments: uv is required (mise install, or https://docs.astral.sh/uv)" >&2; exit 2; }
git ls-files --cached --others --exclude-standard -z |
  uv run --quiet --no-project --with tree-sitter-language-pack==1.25.0 python tools/guard/no_comments.py -
