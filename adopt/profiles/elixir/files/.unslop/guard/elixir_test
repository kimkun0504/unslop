#!/usr/bin/env bash
set -uo pipefail
rm -rf cover/unslop.coverdata .unslop/out/coverage.xml
output=$(env MIX_ENV=test mix test --cover --export-coverage unslop 2>&1)
status=$?
printf '%s\n' "$output"
if [ "$status" -ne 0 ]; then
  if printf '%s\n' "$output" | grep -Eq '[1-9][0-9]* (failed|failures?)\b|\*\* \(' || ! printf '%s\n' "$output" | grep -q 'threshold not met'; then
    exit "$status"
  fi
fi
env MIX_ENV=test mix run --no-start --no-compile .unslop/guard/elixir_coverage.exs cover/unslop.coverdata .unslop/out/coverage.xml
