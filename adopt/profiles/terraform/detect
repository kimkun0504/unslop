#!/usr/bin/env bash
set -euo pipefail
git ls-files '*.tf' | grep -q . || { echo "detect: no .tf files in $(pwd)" >&2; exit 1; }
tests='null'
if git ls-files '*.tftest.hcl' | grep -q .; then
  tests='{"run": "terraform init -backend=false -input=false > /dev/null && terraform test"}'
fi
jq -n --argjson tests "$tests" '{
  stack: "terraform",
  setup: "tflint --init --config \"$PWD/.unslop/config/tflint.hcl\"",
  format: [{name: "terraform fmt", glob: ["*.tf", "*.tfvars", "*.tftest.hcl"], run: "terraform fmt -"}],
  checks: [
    {name: "tflint", format: "sarif", report: ".unslop/out/tflint.sarif",
     run: "tflint --recursive --config \"$PWD/.unslop/config/tflint.hcl\" --format sarif --force > .unslop/out/tflint.sarif"},
    {name: "checkov", format: "sarif", report: ".unslop/out/results_sarif.sarif",
     run: "uvx --python 3.13 checkov==3.4.3 --directory . --framework terraform --skip-path .unslop --output sarif --output-file-path .unslop/out --soft-fail --quiet > /dev/null"}
  ]
} + (if $tests == null then {} else {tests: $tests} end)'
