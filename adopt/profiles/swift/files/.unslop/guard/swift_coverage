#!/usr/bin/env bash
set -euo pipefail
swift test --enable-code-coverage
codecov=$(swift test --show-codecov-path)
profdata="$(dirname "$codecov")/default.profdata"
bin=$(swift build --build-tests --show-bin-path)
binary=$(find "$bin" -maxdepth 1 -name '*PackageTests.xctest' | head -n 1)
[ -n "$binary" ] || { echo "swift_coverage: no test bundle in $bin" >&2; exit 1; }
if [ -d "$binary" ]; then
  binary="$binary/Contents/MacOS/$(basename "$binary" .xctest)"
fi
if command -v llvm-cov >/dev/null 2>&1; then
  llvm-cov export -format=lcov -instr-profile "$profdata" "$binary" -ignore-filename-regex='(\.build|Tests)/' > .unslop/out/coverage.lcov
else
  xcrun llvm-cov export -format=lcov -instr-profile "$profdata" "$binary" -ignore-filename-regex='(\.build|Tests)/' > .unslop/out/coverage.lcov
fi
