#!/usr/bin/env bash
set -euo pipefail
[ -f go.mod ] || { echo "detect: no go.mod in $(pwd)" >&2; exit 1; }
jq -n '{
  stack: "go",
  setup: "go mod download",
  format: [{name: "gofmt", glob: ["*.go"], run: "gofmt"}],
  checks: [{name: "golangci-lint", format: "sarif", report: ".unslop/out/golangci.sarif",
    run: "go run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.15.0 run -c .unslop/config/golangci.yml --output.sarif.path=.unslop/out/golangci.sarif --output.text.path=stderr ./..."}],
  tests: {
    run: "go test -race -covermode=atomic -coverpkg=./... -coverprofile=.unslop/out/cover.out ./... && go run github.com/boumenot/gocover-cobertura@v1.5.0 < .unslop/out/cover.out > .unslop/out/coverage.xml",
    coverage: ".unslop/out/coverage.xml"
  }
}'
