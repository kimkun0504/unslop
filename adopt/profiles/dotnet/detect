#!/usr/bin/env bash
set -euo pipefail
target=$(find . -maxdepth 1 \( -name '*.slnx' -o -name '*.sln' \) | sort | head -n 1)
if [ -z "$target" ]; then
  target=$(find . -maxdepth 1 -name '*.csproj' | sort | head -n 1)
fi
[ -n "$target" ] || { echo "detect: no solution or project file at the root of $(pwd)" >&2; exit 1; }
target=${target#./}
build="dotnet build $target --no-incremental -clp:NoSummary -v:q -p:AnalysisMode=All -p:EnforceCodeStyleInBuild=true -p:Nullable=enable -p:TreatWarningsAsErrors=false -p:WarningsAsErrors= -p:GenerateDocumentationFile=false"
jq -n --arg target "$target" --arg build "$build" '{
  stack: "dotnet",
  setup: "dotnet restore \($target)",
  format: [],
  checks: [{name: "analyzers", format: "msbuild", report: ".unslop/out/build.txt", run: "\($build) > .unslop/out/build.txt"}],
  tests: {
    run: "rm -rf .unslop/out/tests && dotnet test \($target) --collect:\"XPlat Code Coverage\" --results-directory .unslop/out/tests",
    coverage: ".unslop/out/tests/**/coverage.cobertura.xml"
  }
}'
