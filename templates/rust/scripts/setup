#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
command -v rustup >/dev/null || { echo "rustup missing; see https://rustup.rs" >&2; exit 1; }
rustup show active-toolchain >/dev/null
for tool in cargo-deny cargo-llvm-cov cargo-mutants; do
  command -v "$tool" >/dev/null || { echo "$tool missing; run: cargo install --locked $tool" >&2; exit 1; }
done
command -v uv >/dev/null || { echo "uv missing; see https://docs.astral.sh/uv" >&2; exit 1; }
cargo fetch --locked
