#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
git ls-files -co --exclude-standard -z -- '*.kt' '*.kts' |
  xargs -0 uv run --quiet --no-project --python 3.13 --with tree-sitter==0.26.1 --with tree-sitter-kotlin==1.1.0 python tools/guard/kotlin_guard.py
scripts/check-comments
scripts/check-diff
gradle --continue --console=plain spotlessCheck detektMain detektTest test
