#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
mapfile -t kotlin < <(git ls-files -co --exclude-standard -- '*.kt' '*.kts')
uv run --quiet --with tree-sitter==0.26.1 --with tree-sitter-kotlin==1.1.0 python tools/guard/no_comments_kotlin.py "${kotlin[@]}"
scripts/check-diff
gradle --quiet --continue spotlessCheck detekt test
