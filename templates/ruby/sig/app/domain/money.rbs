module App
  module Domain
    class Money
      CENTS_PER_UNIT: Integer
      WHOLE_PERCENT: Integer
      CANONICAL: Regexp

      attr_reader cents: Integer

      def self.zero: () -> Money
      def self.parse: (String raw) -> Money
      def initialize: (Integer cents) -> void
      def plus: (Money other) -> Money
      def less_percent: (Integer percent) -> Money
      def render: () -> String
    end
  end
end
