#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
want=$(cat .ruby-version)
have=$(ruby -e 'print RUBY_VERSION' 2>/dev/null || true)
[ "$have" = "$want" ] || { echo "Ruby $want required (found ${have:-none}); install it with mise, rbenv or ruby/setup-ruby" >&2; exit 1; }
command -v uv >/dev/null || { echo "uv missing; see https://docs.astral.sh/uv" >&2; exit 1; }
bundle config set --local path vendor/bundle
if [ -f Gemfile.lock ]; then
  bundle config set --local frozen true
  bundle install --jobs 4
else
  bundle lock --add-platform x86_64-linux aarch64-linux arm64-darwin x86_64-darwin
  bundle install --jobs 4
  echo "created Gemfile.lock; commit it so every install is reproducible" >&2
fi
