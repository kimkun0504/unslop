#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
scripts/fast-check
profile=$(mktemp)
trap 'rm -f "$profile"' EXIT
go test -count=1 -race -covermode=atomic -coverpkg=./internal/...,./tools/... -coverprofile="$profile" ./...
total=$(go tool cover -func="$profile" | awk '/^total:/ { print $3 }')
[ "$total" = "100.0%" ] || { go tool cover -func="$profile" | grep -v '100.0%' >&2; echo "coverage is $total; 100.0% required" >&2; exit 1; }
for target in $(grep -rl --include='*_test.go' '^func Fuzz' internal | xargs -n1 dirname | sort -u); do
  for fuzz in $(grep -ho '^func Fuzz[A-Za-z0-9_]*' "$target"/*_test.go | sed 's/^func //'); do
    go test -run='^$' -fuzz="^${fuzz}\$" -fuzztime="${FUZZ_TIME:-15s}" "./$target"
  done
done
go build ./...
