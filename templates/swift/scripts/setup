#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
want=$(cat .swift-version)
have=$(swift --version 2>/dev/null | sed -n 's/.*Swift version \([0-9.]*\).*/\1/p' | head -n 1)
[ "$have" = "$want" ] || { echo "Swift $want required (found ${have:-none}); install it with swiftly" >&2; exit 1; }
command -v uv >/dev/null || { echo "uv missing; see https://docs.astral.sh/uv" >&2; exit 1; }
release=https://github.com/realm/SwiftLint/releases/download/0.65.1
case "$(uname -s)-$(uname -m)" in
  Linux-x86_64) asset=swiftlint_linux_amd64.zip sum=caeed6f4a679c35539ffaf124f6c4ab4a8416917f7d8796279dc52b74026059d ;;
  Linux-aarch64 | Linux-arm64) asset=swiftlint_linux_arm64.zip sum=9ffa52f478e6d8eb485d37d14715ffac90abc81c58f3370d598bf75be05605f8 ;;
  Darwin-*) asset=portable_swiftlint.zip sum=c1e429b0599cf1b516f369a2d9ec04eaf0e436f3c12b637df8851fa52ff694d0 ;;
  *) echo "no SwiftLint build for $(uname -s)-$(uname -m)" >&2; exit 1 ;;
esac
if [ ! -x .tools/swiftlint ]; then
  mkdir -p .tools
  curl -fsSL --retry 3 -o .tools/swiftlint.zip "$release/$asset"
  uv run --quiet --no-project --python 3.13 python - .tools/swiftlint.zip "$sum" <<'PY'
import hashlib
import sys
import zipfile
from pathlib import Path

archive, expected = Path(sys.argv[1]), sys.argv[2]
actual = hashlib.sha256(archive.read_bytes()).hexdigest()
if actual != expected:
    raise SystemExit(f"SwiftLint checksum mismatch: {actual}")
with zipfile.ZipFile(archive) as bundle:
    target = Path(".tools/swiftlint")
    target.write_bytes(bundle.read("swiftlint"))
    target.chmod(0o755)
archive.unlink()
PY
fi
swift build --build-tests
