#!/usr/bin/env php
<?php

declare(strict_types=1);

use App\Cli\Application;
use App\Cli\StreamOutput;

require dirname(__DIR__) . '/vendor/autoload.php';

$application = new Application(
    new StreamOutput(new SplFileObject('php://stdout', 'w')),
    new StreamOutput(new SplFileObject('php://stderr', 'w')),
);

$serverArguments = $_SERVER['argv'] ?? [];
$arguments = is_array($serverArguments) ? array_values(array_filter(array_slice($serverArguments, 1), is_string(...))) : [];

exit($application->run(...$arguments));
