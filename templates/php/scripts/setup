#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
php -r 'exit(version_compare(PHP_VERSION, "8.5.0", ">=") && version_compare(PHP_VERSION, "8.6.0", "<") ? 0 : 1);' || { echo "PHP 8.5 required (found $(php -r 'echo PHP_VERSION;'))" >&2; exit 1; }
command -v composer >/dev/null || { echo "composer missing; see https://getcomposer.org" >&2; exit 1; }
command -v uv >/dev/null || { echo "uv missing; see https://docs.astral.sh/uv" >&2; exit 1; }
composer validate --strict --no-interaction
if [ -f composer.lock ]; then
  composer install --no-interaction --no-progress
else
  composer update --no-interaction --no-progress
  echo "created composer.lock; commit it so every install is reproducible" >&2
fi
