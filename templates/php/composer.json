{
    "name": "example/app",
    "description": "Pricing service",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "~8.5.0"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "friendsofphp/php-cs-fixer": "^3.95",
        "infection/infection": "^0.35",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^13.4",
        "spaze/phpstan-disallowed-calls": "^4.15"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.5.0"
        },
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "audit": {
            "abandoned": "fail"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
