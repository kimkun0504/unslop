#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

uv run --locked ruff format --check
uv run --locked ruff check --ignore-noqa --no-fix
scripts/check-comments
uv run --locked basedpyright
uv run --locked lint-imports
scripts/check-diff
uv run --locked pytest -q -x -p no:randomly --no-header
