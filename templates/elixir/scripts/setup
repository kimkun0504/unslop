#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
want=$(awk '$1 == "elixir" { print $2 }' .tool-versions)
have=$(elixir --short-version 2>/dev/null || true)
[ "$have" = "${want%%-otp-*}" ] || { echo "Elixir ${want%%-otp-*} required (found ${have:-none}); install it with mise, asdf or erlef/setup-beam" >&2; exit 1; }
command -v uv >/dev/null || { echo "uv missing; see https://docs.astral.sh/uv" >&2; exit 1; }
mix local.hex --force --if-missing
mix local.rebar --force --if-missing
if [ -f mix.lock ]; then
  mix deps.get --check-locked
else
  mix deps.get
  echo "created mix.lock; commit it so every install is reproducible" >&2
fi
env MIX_ENV=test mix deps.compile
mix dialyzer --plt
