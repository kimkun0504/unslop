{
  "templates": [
    {
      "name": "python",
      "title": "Python",
      "kind": "service",
      "toolchain": {
        "python": "3.13",
        "uv": "0.13.9"
      },
      "gates": {
        "format": "ruff format",
        "lint": "ruff (ALL rules)",
        "types": "basedpyright (all)",
        "architecture": "import-linter",
        "tests": "pytest strict + hypothesis",
        "coverage": "100% branch",
        "mutation": "mutmut, 100% killed",
        "dead-code": "deptry",
        "supply-chain": "uv lock, 7-day release age, pip-audit"
      }
    },
    {
      "name": "ts-react",
      "title": "TypeScript + React",
      "kind": "web",
      "toolchain": {
        "node": "22",
        "pnpm": "12.21.0"
      },
      "gates": {
        "format": "prettier",
        "lint": "typescript-eslint strict-type-checked, jsx-a11y strict, react-hooks",
        "types": "tsc @tsconfig/strictest",
        "architecture": "eslint-plugin-boundaries",
        "tests": "vitest + testing-library + fast-check",
        "coverage": "100% lines and branches",
        "mutation": "stryker, 100% score",
        "dead-code": "knip",
        "supply-chain": "pnpm lockfile, 1-day release age, pnpm audit",
        "design-system": "tailwind tokens only, no arbitrary values or inline styles"
      }
    },
    {
      "name": "go",
      "title": "Go",
      "kind": "service",
      "toolchain": {
        "go": "1.27.4",
        "golangci-lint": "2.15.0"
      },
      "gates": {
        "format": "gofumpt, goimports",
        "lint": "golangci-lint (all linters)",
        "types": "go vet (enable-all)",
        "architecture": "depguard layer rules",
        "tests": "go test -race -shuffle + native fuzzing",
        "coverage": "100% statements in internal/",
        "mutation": null,
        "dead-code": "unused, unparam",
        "supply-chain": "go mod verify, go mod tidy -diff, govulncheck"
      }
    },
    {
      "name": "kotlin-spring",
      "title": "Kotlin + Spring Boot",
      "kind": "service",
      "toolchain": {
        "java": "21",
        "gradle": "9.9.1",
        "kotlin": "2.4.21",
        "spring-boot": "4.1.2"
      },
      "gates": {
        "format": "ktlint via spotless",
        "lint": "detekt (all rules) + syntax guard for println, TODO and !!",
        "types": "kotlinc allWarningsAsErrors",
        "architecture": "Spring Modulith verify",
        "tests": "JUnit 5 + Spring Boot integration tests",
        "coverage": "100% lines and branches (JaCoCo)",
        "mutation": "PIT STRONGER, 100% killed",
        "dead-code": "detekt unused rules",
        "supply-chain": "Gradle version catalog"
      }
    },
    {
      "name": "java-spring",
      "title": "Java + Spring Boot",
      "kind": "service",
      "toolchain": {
        "java": "25",
        "gradle": "9.9.1",
        "spring-boot": "4.1.2"
      },
      "gates": {
        "format": "google-java-format via spotless",
        "lint": "Error Prone (SystemOut as error), javac -Xlint:all -Werror",
        "types": "NullAway in JSpecify mode on @NullMarked packages",
        "architecture": "Spring Modulith verify",
        "tests": "JUnit 5 + AssertJ + Spring Boot integration tests",
        "coverage": "100% lines and branches (JaCoCo)",
        "mutation": "PIT STRONGER, 100% killed",
        "dead-code": "javac and Error Prone unused checks",
        "supply-chain": "Gradle version catalog"
      }
    },
    {
      "name": "terraform",
      "title": "Terraform on AWS",
      "kind": "infrastructure",
      "toolchain": {
        "terraform": "1.17.2",
        "tflint": "0.66.0",
        "aws-provider": "~> 6.73"
      },
      "gates": {
        "format": "terraform fmt",
        "lint": "tflint (terraform preset all + AWS ruleset)",
        "types": "terraform validate, typed and validated variables",
        "architecture": "root module composes single-purpose modules",
        "tests": "terraform test with mocked providers",
        "coverage": "every validation and secure default asserted",
        "mutation": null,
        "dead-code": "tflint terraform_unused_declarations",
        "supply-chain": "provider lockfile, pinned provider and plugin versions",
        "security": "checkov"
      }
    },
    {
      "name": "rust",
      "title": "Rust",
      "kind": "service",
      "toolchain": {
        "rust": "1.100.0",
        "edition": "2024"
      },
      "gates": {
        "format": "rustfmt",
        "lint": "clippy all, pedantic, nursery, cargo and restriction lints (unwrap, expect, panic, indexing, print, arithmetic) denied; #[allow] denied",
        "types": "rustc with unsafe_code forbidden",
        "architecture": "workspace crates; clippy.toml bans I/O in the domain crate",
        "tests": "cargo test + proptest + binary integration tests",
        "coverage": "100% lines (cargo-llvm-cov)",
        "mutation": "cargo-mutants, none missed",
        "dead-code": "rustc unused lints denied",
        "supply-chain": "Cargo.lock --locked, cargo-deny advisories, licenses, bans, sources"
      }
    },
    {
      "name": "dotnet",
      "title": "C# + ASP.NET Core",
      "kind": "service",
      "toolchain": {
        "dotnet-sdk": "10.0.404",
        "framework": "net10.0"
      },
      "gates": {
        "format": "dotnet format --verify-no-changes",
        "lint": "AnalysisMode All, every analyzer and code-style rule as an error",
        "types": "nullable reference types, warnings as errors",
        "architecture": "domain assembly may reference only core framework assemblies (architecture test)",
        "tests": "xUnit v3 + WebApplicationFactory integration tests",
        "coverage": "100% lines and branches (coverlet)",
        "mutation": "Stryker.NET, 100% score",
        "dead-code": "IDE and CA unused-code analyzers",
        "supply-chain": "central package versions, lockfiles in locked mode, NuGet audit of transitive packages"
      }
    }
  ]
}
