{
  "templates": [
    {
      "name": "python",
      "title": "Python",
      "kind": "service",
      "toolchain": {
        "python": "3.13",
        "uv": "0.13.9"
      },
      "gates": {
        "format": "ruff format",
        "lint": "ruff (ALL rules)",
        "types": "basedpyright (all)",
        "architecture": "import-linter",
        "tests": "pytest strict + hypothesis",
        "coverage": "100% branch",
        "mutation": "mutmut, 100% killed",
        "dead-code": "deptry",
        "supply-chain": "uv lock, 7-day release age, pip-audit"
      },
      "summary": {
        "format": "ruff format",
        "lint": "ruff (all rules), basedpyright (all)",
        "architecture": "import-linter",
        "tests": "pytest, hypothesis",
        "mutation": "mutmut"
      },
      "adopt": "python"
    },
    {
      "name": "ts-react",
      "title": "TypeScript + React",
      "kind": "web",
      "toolchain": {
        "node": "24.22.3",
        "pnpm": "12.21.0"
      },
      "gates": {
        "format": "prettier",
        "lint": "typescript-eslint strict-type-checked, jsx-a11y strict, react-hooks",
        "types": "tsc @tsconfig/strictest",
        "architecture": "eslint-plugin-boundaries",
        "tests": "vitest + testing-library + fast-check",
        "coverage": "100% lines and branches",
        "mutation": "stryker, 100% score",
        "dead-code": "knip",
        "supply-chain": "pnpm lockfile, 1-day release age, pnpm audit",
        "design-system": "tailwind tokens only, consistent class order, no duplicate, conflicting or arbitrary classes, no inline styles"
      },
      "summary": {
        "format": "prettier",
        "lint": "typescript-eslint strict, tsc strictest, jsx-a11y",
        "architecture": "eslint-plugin-boundaries",
        "tests": "vitest, testing-library, fast-check",
        "mutation": "Stryker"
      },
      "adopt": "typescript"
    },
    {
      "name": "kotlin-spring",
      "title": "Kotlin + Spring Boot",
      "kind": "service",
      "toolchain": {
        "java": "21",
        "gradle": "9.9.1",
        "kotlin": "2.4.21",
        "spring-boot": "4.1.2"
      },
      "gates": {
        "format": "ktlint via spotless",
        "lint": "detekt (all rules) + syntax guard for println, TODO and !!",
        "types": "kotlinc allWarningsAsErrors",
        "architecture": "Spring Modulith verify",
        "tests": "JUnit 5 + Spring Boot integration tests",
        "coverage": "100% lines and branches (JaCoCo)",
        "mutation": "PIT STRONGER, 100% killed",
        "dead-code": "detekt unused rules",
        "supply-chain": "Gradle version catalog"
      },
      "summary": {
        "format": "ktlint",
        "lint": "detekt (all rules), warnings as errors",
        "architecture": "Spring Modulith",
        "tests": "JUnit 5, Spring Boot",
        "mutation": "PIT"
      },
      "adopt": "jvm"
    },
    {
      "name": "java-spring",
      "title": "Java + Spring Boot",
      "kind": "service",
      "toolchain": {
        "java": "25",
        "gradle": "9.9.1",
        "spring-boot": "4.1.2"
      },
      "gates": {
        "format": "google-java-format via spotless",
        "lint": "Error Prone (SystemOut as error), javac -Xlint:all -Werror",
        "types": "NullAway in JSpecify mode on @NullMarked packages",
        "architecture": "Spring Modulith verify",
        "tests": "JUnit 5 + AssertJ + Spring Boot integration tests",
        "coverage": "100% lines and branches (JaCoCo)",
        "mutation": "PIT STRONGER, 100% killed",
        "dead-code": "javac and Error Prone unused checks",
        "supply-chain": "Gradle version catalog"
      },
      "summary": {
        "format": "google-java-format",
        "lint": "Error Prone, NullAway (JSpecify), `-Xlint:all -Werror`",
        "architecture": "Spring Modulith",
        "tests": "JUnit 5, AssertJ, Spring Boot",
        "mutation": "PIT"
      },
      "adopt": "jvm"
    }
  ],
  "adopt": [
    {
      "name": "python",
      "title": "Python",
      "detects": "uv, Poetry or pip projects",
      "format": "ruff format",
      "checks": "ruff (all rules), basedpyright strict",
      "tests": "pytest with branch coverage"
    },
    {
      "name": "typescript",
      "title": "TypeScript and JavaScript",
      "detects": "npm, pnpm or Yarn projects",
      "format": "prettier, when the project uses it",
      "checks": "tsc with strictest flags, the project's ESLint config",
      "tests": "vitest or jest with coverage"
    },
    {
      "name": "jvm",
      "title": "Java and Kotlin",
      "detects": "Gradle or Maven builds",
      "format": "none; the project's own formatter",
      "checks": "PMD for Java, detekt (all rules) for Kotlin",
      "tests": "JaCoCo added without editing the build"
    }
  ]
}
